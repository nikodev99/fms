<?xml version="1.0" encoding="UTF-8"?>

<?import org.gu.fms.desktop.platform.ui.icon.FmsIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Coque FMS. Racine = StackPane : la coque est la première couche, tiroirs, dialogues et
  notifications s'empilent au-dessus (OverlayHost).
  Règle « responsive tout le temps » : BorderPane, Hgrow/Vgrow = ALWAYS, aucune coordonnée en pixels.
  Couleurs : uniquement via fms.css.
  Menu latéral : déplié (libellés) ou réduit (icônes seules, info-bulles) ; largeur gérée par ShellController.
-->
<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.gu.fms.desktop.app.shell.ShellController"
           styleClass="app-root">

    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
    </fx:define>

    <BorderPane>
        <!-- ================= Menu latéral ================= -->
        <left>
            <VBox fx:id="sidebar" styleClass="sidebar">
                <HBox fx:id="brand" styleClass="brand" alignment="CENTER_LEFT">
                    <StackPane>
                        <ImageView fx:id="logoImage" fitWidth="38" fitHeight="38" preserveRatio="true" smooth="true"
                                   visible="false" managed="false"/>
                        <Label fx:id="logoFallback" text="FMS" styleClass="brand-logo-fallback"/>
                    </StackPane>
                    <VBox fx:id="brandText">
                        <Label text="FMS" styleClass="brand-name"/>
                        <Label text="%shell.tagline" styleClass="brand-tagline"/>
                    </VBox>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <VBox fx:id="navBox" styleClass="nav"/>
                </ScrollPane>

                <HBox fx:id="sidebarFooter" styleClass="sidebar-footer" alignment="CENTER_LEFT">
                    <Label fx:id="userInitials" styleClass="avatar"/>
                    <VBox fx:id="userBox" HBox.hgrow="ALWAYS">
                        <Label fx:id="userName" styleClass="user-name"/>
                        <Label fx:id="userRole" styleClass="user-role"/>
                    </VBox>
                    <Button fx:id="settingsButton" styleClass="icon-button, sidebar-icon">
                        <graphic><FmsIcon icon="SETTINGS" size="18"/></graphic>
                        <tooltip><Tooltip text="%nav.settings"/></tooltip>
                    </Button>
                </HBox>
            </VBox>
        </left>

        <!-- ================= Zone principale ================= -->
        <center>
            <BorderPane>
                <top>
                    <HBox styleClass="topbar">
                        <Button fx:id="sidebarToggle" styleClass="icon-button, sidebar-toggle">
                            <graphic><FmsIcon fx:id="sidebarToggleIcon" icon="MENU_OPEN" size="20"/></graphic>
                        </Button>
                        <HBox styleClass="breadcrumb" alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="breadcrumbSection" styleClass="breadcrumb-section"/>
                            <FmsIcon icon="CHEVRON_RIGHT" size="16" styleClass="breadcrumb-separator"
                                     managed="${breadcrumbSection.managed}" visible="${breadcrumbSection.visible}"/>
                            <Label fx:id="breadcrumbPage" styleClass="breadcrumb-page"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox styleClass="segmented">
                            <ToggleButton fx:id="themeLight" text="%theme.light" toggleGroup="$themeGroup">
                                <graphic><FmsIcon icon="THEME_LIGHT" size="15"/></graphic>
                            </ToggleButton>
                            <ToggleButton fx:id="themeDark" text="%theme.dark" toggleGroup="$themeGroup">
                                <graphic><FmsIcon icon="THEME_DARK" size="15"/></graphic>
                            </ToggleButton>
                            <ToggleButton fx:id="themeSystem" text="%theme.system" toggleGroup="$themeGroup">
                                <graphic><FmsIcon icon="THEME_SYSTEM" size="15"/></graphic>
                                <tooltip><Tooltip text="%theme.system.tooltip"/></tooltip>
                            </ToggleButton>
                        </HBox>
                    </HBox>
                </top>

                <center>
                    <StackPane fx:id="contentHost" styleClass="content-host"/>
                </center>

                <bottom>
                    <HBox styleClass="status-bar">
                        <FmsIcon icon="DATABASE" size="14"/>
                        <Label fx:id="databaseLabel"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="%shell.version"/>
                    </HBox>
                </bottom>
            </BorderPane>
        </center>
    </BorderPane>
</StackPane>
